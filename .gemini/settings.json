{
  "context": {
    "fileName": "AGENTS.md"
  },
  "hooks": {
    "AfterAgent": [
      {
        "hooks": [
          {
            "command": "go run ./cmd/reifu hook verify",
            "type": "command"
          }
        ]
      }
    ]
  },
  "tools": {
    "allowed": [
      "run_shell_command(*)"
    ],
    "exclude": [
      "run_shell_command(git push *)",
      "run_shell_command(git reset --hard*)",
      "run_shell_command(rm -rf *)",
      "run_shell_command(git push*)",
      "run_shell_command(git clean*)",
      "run_shell_command(git checkout -- *)",
      "run_shell_command(git branch -D*)",
      "run_shell_command(Remove-Item*-Recurse*)",
      "run_shell_command(rd /s*)",
      "run_shell_command(rmdir /s*)",
      "run_shell_command(del /s*)"
    ]
  }
}
