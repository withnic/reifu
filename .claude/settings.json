{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "command": "go run ./cmd/reifu hook verify",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go mod *)",
      "Bash(go version)",
      "Bash(gofmt *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(reifu version)",
      "Bash(reifu status*)",
      "Bash(reifu link --check)",
      "Bash(reifu hook verify)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Edit(C:/Windows/**)",
      "Edit(C:/Program Files/**)",
      "Edit(C:/Program Files (x86)/**)",
      "Edit(.claude/settings.json)",
      "Edit(.codex/config.toml)",
      "Edit(.gemini/settings.json)",
      "Read(.claude/settings.local.json)",
      "Edit(.claude/settings.local.json)",
      "Read(.gemini/settings.local.json)",
      "Edit(.gemini/settings.local.json)"
    ]
  }
}
