{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "command": "go run ./cmd/reifu hook verify",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(*)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Edit(C:/Windows/**)",
      "Edit(C:/Program Files/**)",
      "Edit(C:/Program Files (x86)/**)",
      "Edit(.claude/settings.json)",
      "Edit(.codex/config.toml)",
      "Edit(.gemini/settings.json)",
      "Read(.claude/settings.local.json)",
      "Edit(.claude/settings.local.json)",
      "Read(.gemini/settings.local.json)",
      "Edit(.gemini/settings.local.json)",
      "Bash(git push*)",
      "Bash(git clean*)",
      "Bash(git checkout -- *)",
      "Bash(git branch -D*)",
      "Bash(Remove-Item*-Recurse*)",
      "Bash(rd /s*)",
      "Bash(rmdir /s*)",
      "Bash(del /s*)"
    ]
  }
}
